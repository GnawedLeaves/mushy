NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Bypasses RLS -- used only by
# the two extension API routes and the PAT Server Action.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Free-tier Gemini key used to auto-tag a save's aesthetic (modern,
# y2k, minimalist, etc.) after it's saved -- powers Discover's tag search.
# Runs via next/server's after() so it never delays the save response. If
# unset, saves are just never tagged; nothing else breaks.
GEMINI_API_KEY=
